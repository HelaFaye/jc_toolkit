.PHONY: all clean interactive install uninstall help

CXX := g++
CXXFLAGS := -Wall -Wextra -O2
LDFLAGS := $(shell pkg-config --libs hidapi-hidraw)
CPPFLAGS := $(shell pkg-config --cflags hidapi-hidraw)

# Named jctool-cli: the repository root already has a jctool/ folder (the Windows sources).
TARGETS := jctool-cli

all: $(TARGETS)

jctool-cli: jctool_linux_interactive.cpp
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -o $@ $< $(LDFLAGS)
	@echo "[✓] Built $@"

interactive: jctool-cli
	@echo "[*] Running interactive menu..."
	./jctool-cli

install: all
	@echo "[*] Installing to /usr/local/bin..."
	install -m 755 jctool-cli /usr/local/bin/
	@echo "[✓] Installation complete"

uninstall:
	rm -f /usr/local/bin/jctool-cli
	@echo "[✓] Uninstallation complete"

clean:
	rm -f $(TARGETS) *.o *.a *.so
	@echo "[✓] Cleaned"

help:
	@echo "Joy-Con Toolkit (Linux CLI) - Make targets:"
	@echo "  all         - Build jctool-cli (default)"
	@echo "  interactive - Build and run the interactive menu"
	@echo "  install     - Install jctool-cli to /usr/local/bin"
	@echo "  uninstall   - Remove it from /usr/local/bin"
	@echo "  clean       - Remove build output"
